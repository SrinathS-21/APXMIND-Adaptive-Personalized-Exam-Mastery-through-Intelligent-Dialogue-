# ===========================================================================
#  APXMIND Configuration
#  Copy this file to .env and customize as needed.
#  All variables use the APXMIND_ prefix.
# ===========================================================================

# ——— LLM Configuration (Optimized for 8GB RAM, CPU Only) ———
APXMIND_LLM_MODEL_PATH=models/Llama-3.2-3B-Instruct-Q4_K_M.gguf
APXMIND_EMBEDDING_MODEL_PATH=models/nomic-embed-text-v1.5.Q8_0.gguf
APXMIND_LLM_TEMPERATURE=0.0
APXMIND_LLM_MAX_TOKENS=700
APXMIND_CREATIVE_TEMPERATURE=0.7
APXMIND_N_GPU_LAYERS=0
APXMIND_N_CTX=2048

# Ollama fallback (used when GGUF models aren't downloaded yet)
APXMIND_OLLAMA_BASE_URL=http://localhost:11434
APXMIND_OLLAMA_MODEL=llama3.2
APXMIND_EMBEDDING_MODEL=nomic-embed-text
APXMIND_USE_OLLAMA_FALLBACK=true

# ─── Database ──────────────────────────────────────────────────────────────
APXMIND_DATABASE_URL=sqlite+aiosqlite:///APXMIND.db

# ─── ChromaDB ──────────────────────────────────────────────────────────────
APXMIND_CHROMA_PERSIST_DIR=./src/APXMIND/vectordb

# ─── Server ────────────────────────────────────────────────────────────────
APXMIND_HOST=127.0.0.1
APXMIND_PORT=8000
APXMIND_DEBUG=true
APXMIND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Auth ──────────────────────────────────────────────────────────────────
APXMIND_JWT_SECRET=change-me-in-production
APXMIND_JWT_ALGORITHM=HS256
APXMIND_JWT_EXPIRY_HOURS=24

# ─── Logging ──────────────────────────────────────────────────────────────
APXMIND_LOG_LEVEL=INFO
APXMIND_LOG_FILE=logs/APXMIND_api.log
